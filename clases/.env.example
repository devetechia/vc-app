# Copia este archivo a .env y completa tus keys
# NUNCA commitees .env — solo .env.example

YT_API_KEY=your_youtube_api_key_here
YT_CHANNEL_ID=your_youtube_channel_id_here
OPENROUTER_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
PORT=5000
# Proxy residencial para Fly (opcional, para youtube_transcript_api + yt-dlp)
# Ej: http://user:pass@p.webshare.io:80  o  http://proxy:port
PROXY_URL=
# Ventana de cultos con directo (domingos 10-14h Madrid por defecto)
# LIVE_DAYS: 0=lun ... 6=dom
LIVE_TZ=Europe/Madrid
LIVE_DAYS=6
LIVE_START_HOUR=10
LIVE_END_HOUR=14
LIVE_NEG_TTL=1800
LIVE_POS_TTL=180
LIVE_QUOTA_CAP=8000
